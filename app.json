{
  "expo": {
    "name": "TeloDije",
    "slug": "telodije",
    "scheme": "telodije",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "pe.telodije.app",
      "supportsTablet": false,
      "config": {
        "googleMapsApiKey": "AIzaSyC-Ctf5iAilxLD76KtbXw37JjSIyzLD5sg"
      }
    },
    "android": {
      "package": "pe.telodije.app",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyA28lCf-uooJkG6s00PJ5Wduifb1-rPeWk"
        }
      },
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-secure-store",
      "./plugins/withWorkManagerRules.js",
      [
        "expo-camera",
        {
          "cameraPermission": "TeloDije necesita la cámara para registrar tu foto de llegada."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TeloDije usa tu ubicación para mostrar los hospedajes cerca de ti."
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "cca7d74c-3c04-4264-bd1a-0d16e283c38f"
      }
    }
  }
}
